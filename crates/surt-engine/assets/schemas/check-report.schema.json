{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "checks.run report",
  "type": "object",
  "additionalProperties": false,
  "required": ["commit", "checks"],
  "properties": {
    "commit": { "$ref": "#/definitions/sha" },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/definitions/check" }
    }
  },
  "definitions": {
    "sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "exit_code", "duration_ms", "output_tail"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "status": { "enum": ["passed", "failed", "timed_out", "not_started"] },
        "exit_code": { "type": ["integer", "null"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "output_tail": {
          "description": "Last 200 lines of combined stdout and stderr.",
          "type": "string"
        }
      }
    }
  }
}
