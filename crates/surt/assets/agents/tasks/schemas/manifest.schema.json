{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Built-in feature workflow Task manifest",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["key", "needs", "title", "description", "acceptance_criteria", "files"],
    "properties": {
      "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$" },
      "needs": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$" }
      },
      "title": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "acceptance_criteria": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "files": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task"],
        "properties": {
          "task": { "type": "string", "minLength": 1, "pattern": "\\.md$" }
        }
      }
    }
  }
}
