{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "git.integrate conflict",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "integration_tip", "reviewed_commit", "paths"],
      "properties": {
        "kind": { "const": "merge" },
        "integration_tip": { "$ref": "#/definitions/sha" },
        "reviewed_commit": { "$ref": "#/definitions/sha" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "integration_tip", "reviewed_commit", "merge_commit", "checks"],
      "properties": {
        "kind": { "const": "checks" },
        "integration_tip": { "$ref": "#/definitions/sha" },
        "reviewed_commit": { "$ref": "#/definitions/sha" },
        "merge_commit": { "$ref": "#/definitions/sha" },
        "checks": {
          "description": "Same items as check-report.checks, run on merge_commit.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "check-report.schema.json#/definitions/check" }
        }
      }
    }
  ],
  "definitions": {
    "sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}
