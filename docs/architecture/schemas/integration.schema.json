{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "git.snapshot_integration result",
  "type": "object",
  "additionalProperties": false,
  "required": ["branch", "base", "tip", "tasks"],
  "properties": {
    "branch": { "type": "string", "minLength": 1 },
    "base": { "$ref": "base.schema.json" },
    "tip": { "$ref": "#/definitions/sha" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "reviewed_commit", "merge_commit"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$" },
          "reviewed_commit": { "$ref": "#/definitions/sha" },
          "merge_commit": { "$ref": "#/definitions/sha" }
        }
      }
    }
  },
  "definitions": {
    "sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}
